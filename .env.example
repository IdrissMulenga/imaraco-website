# Public site address (no trailing slash). Used for links shared on Google & social media.
NEXT_PUBLIC_SITE_URL=https://imaracompany.com

# Public contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=support@imaracompany.com
# WhatsApp number: country code + number, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=25761228778

# ---- Email (https://resend.com) ----
# API key from resend.com → API Keys
RESEND_API_KEY=
# Inbox that receives contact, quote, pilot, order and sign-up messages
CONTACT_TO_EMAIL=support@imaracompany.com
# Sender of all emails (optional: defaults to "Imara <support@imaracompany.com>").
# The domain (imaracompany.com) must be verified in Resend, or emails fail.
CONTACT_FROM_EMAIL="Imara <support@imaracompany.com>"
# Optional: Resend audience (mailing list) ID for newsletter / "Notify me" sign-ups
RESEND_AUDIENCE_ID=

# ---- Spam limits (optional, recommended in production) ----
# Upstash Redis (free tier) so form limits are shared by all servers.
# On Vercel: Storage → Upstash for Redis fills these in automatically
# (as KV_REST_API_URL / KV_REST_API_TOKEN, which also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Privacy-friendly analytics (optional; set ONE)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Imara Afya store listings (used once the app is launched)
NEXT_PUBLIC_AFYA_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=YOUR.APP.ID
NEXT_PUBLIC_AFYA_APP_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID
